#!/bin/sh
set -e

lb config noauto \
  --mode debian \
  --architectures amd64 \
  --distribution trixie \
  --archive-areas "main contrib non-free non-free-firmware" \
  --mirror-bootstrap "http://deb.debian.org/debian/" \
  --mirror-chroot "http://deb.debian.org/debian/" \
  --mirror-binary "http://deb.debian.org/debian/" \
  --security false \
  --debian-installer live \
  --apt-recommends false \
  --bootappend-live "boot=live components quiet splash locales=en_US.UTF-8 username=live hostname=the-nexus-os" \
  --iso-application "The Nexus OS 1.1" \
  --iso-publisher "The Nexus OS" \
  --iso-volume "NEXUS_OS_1_1" \
  "${@}"
