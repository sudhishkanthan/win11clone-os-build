[Icon Theme]
Name=NexusOS
Comment=The Nexus OS 2.5D Soft-Gradient & White Symbolic Icon Theme
Inherits=breeze-dark,hicolor
Example=folder
Directories=48x48/apps,128x128/apps,256x256/apps,48x48/places,128x128/places,256x256/places,32x32/status,32x32/actions,scalable/status,scalable/actions

[48x48/apps]
Size=48
Context=Applications
Type=Fixed

[128x128/apps]
Size=128
Context=Applications
Type=Fixed

[256x256/apps]
Size=256
Context=Applications
Type=Scalable
MinSize=32
MaxSize=512

[48x48/places]
Size=48
Context=Places
Type=Fixed

[128x128/places]
Size=128
Context=Places
Type=Fixed

[256x256/places]
Size=256
Context=Places
Type=Scalable
MinSize=32
MaxSize=512

[32x32/status]
Size=32
Context=Status
Type=Fixed

[32x32/actions]
Size=32
Context=Actions
Type=Fixed

[scalable/status]
Size=64
Context=Status
Type=Scalable
MinSize=16
MaxSize=256

[scalable/actions]
Size=64
Context=Actions
Type=Scalable
MinSize=16
MaxSize=256
