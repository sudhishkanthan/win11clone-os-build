Window.SetBackgroundTopColor(0.0, 0.0, 0.0);
Window.SetBackgroundBottomColor(0.0, 0.0, 0.0);

logo_img = Image("logo.png").Scale(140, 140);
logo_sprite = Sprite(logo_img);
logo_sprite.SetX(Window.GetWidth() / 2 - logo_img.GetWidth() / 2);
logo_sprite.SetY(Window.GetHeight() / 2 - 90);

wm_img = Image("wordmark.png").Scale(300, 46);
wm_sprite = Sprite(wm_img);
wm_sprite.SetX(Window.GetWidth() / 2 - wm_img.GetWidth() / 2);
wm_sprite.SetY(Window.GetHeight() / 2 + 74);
