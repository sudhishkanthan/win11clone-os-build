#!/usr/bin/env bash
# ==============================================================================
# Chroot Hook 0100: Install VirtualBox Guest Additions via Debian Fast Track
# Ref: https://wiki.debian.org/VirtualBox & https://fasttrack.debian.net/
# ==============================================================================
set -euo pipefail

export DEBIAN_FRONTEND=noninteractive

echo "[0100-virtualbox-guest] Enabling trixie-backports and trixie-fasttrack..."

cat <<'EOF' > /etc/apt/sources.list.d/trixie-backports.sources
Types: deb
URIs: http://deb.debian.org/debian/
Suites: trixie-backports
Components: main contrib non-free non-free-firmware
Enabled: yes
Signed-By: /usr/share/keyrings/debian-archive-keyring.gpg
EOF

cat <<'EOF' > /etc/apt/sources.list.d/trixie-fasttrack.sources
Types: deb
URIs: http://fasttrack.debian.net/debian-fasttrack/
Suites: trixie-fasttrack trixie-backports-staging
Components: main contrib
Enabled: yes
Signed-By: /usr/share/keyrings/fasttrack-archive-keyring.gpg
EOF

apt-get update -qq
apt-get install -y --no-install-recommends \
  virtualbox-guest-utils \
  virtualbox-guest-x11

if systemctl list-unit-files | grep -q '^virtualbox-guest-utils\.service'; then
  systemctl enable virtualbox-guest-utils.service
fi

apt-get clean
echo "[0100-virtualbox-guest] VirtualBox Guest Additions installed."
