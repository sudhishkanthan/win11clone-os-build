#!/usr/bin/env bash
# ==============================================================================
# Chroot Hook 0200: Install Windows 11 Fluent KDE Plasma Theme & Icon Pack
# Sources:
#   - https://github.com/vinceliuice/Fluent-kde
#   - https://github.com/yeyushengfan258/Win11-icon-theme
# ==============================================================================
set -euo pipefail

readonly THEME_TMP="/tmp/win11-theme-build"
rm -rf "${THEME_TMP}"
mkdir -p "${THEME_TMP}"

echo "[0200-win11-theme] Cloning and installing Fluent-kde (round Light/Dark variants)..."
git clone --depth 1 https://github.com/vinceliuice/Fluent-kde.git "${THEME_TMP}/Fluent-kde"
(
  cd "${THEME_TMP}/Fluent-kde"
  chmod +x ./install.sh
  ./install.sh --round
)

echo "[0200-win11-theme] Cloning and installing Win11-icon-theme..."
git clone --depth 1 https://github.com/yeyushengfan258/Win11-icon-theme.git "${THEME_TMP}/Win11-icon-theme"
(
  cd "${THEME_TMP}/Win11-icon-theme"
  chmod +x ./install.sh
  ./install.sh -d /usr/share/icons
)

# Refresh icon caches if gtk-update-icon-cache is present
if command -v gtk-update-icon-cache >/dev/null 2>&1; then
  for icon_dir in /usr/share/icons/Win11*; do
    if [[ -d "${icon_dir}" ]]; then
      gtk-update-icon-cache -f -t "${icon_dir}" || true
    fi
  done
fi

rm -rf "${THEME_TMP}"
echo "[0200-win11-theme] Fluent-kde and Win11-icon-theme installed system-wide."
