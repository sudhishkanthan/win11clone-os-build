#!/usr/bin/env bash
# ==============================================================================
# Chroot Hook 0300: System Services, OS Branding, Wallpapers & Desktop Config
# ==============================================================================
set -euo pipefail

echo "[0300-system-branding] Enabling SDDM and NetworkManager..."
systemctl enable sddm.service
systemctl enable NetworkManager.service

# Update PRETTY_NAME while preserving Debian ID and VERSION_CODENAME for APT/Calamares
if [[ -f /etc/os-release ]]; then
  sed -i 's/^PRETTY_NAME=.*/PRETTY_NAME="The Nexus OS 1.0 (Debian 13 Trixie)"/' /etc/os-release
  sed -i 's/^NAME=.*/NAME="The Nexus OS"/' /etc/os-release
fi

# Customize Calamares live desktop launcher label
if [[ -f /usr/share/applications/install-debian.desktop ]]; then
  sed -i 's/^Name=.*/Name=Install The Nexus OS/' /usr/share/applications/install-debian.desktop
  mkdir -p /etc/skel/Desktop
  cp -f /usr/share/applications/install-debian.desktop /etc/skel/Desktop/install-nexus-os.desktop
  chmod +x /etc/skel/Desktop/install-nexus-os.desktop
fi

# Ensure layout initialization script is executable
if [[ -f /usr/local/bin/nexus-apply-layout.sh ]]; then
  chmod +x /usr/local/bin/nexus-apply-layout.sh
fi

# Override Debian default wallpapers system-wide with NexusOS dark mountain lake wallpaper
readonly NEXUS_WALLPAPER="/usr/share/wallpapers/NexusOS/contents/images/1920x1080.jpg"
readonly NEXUS_LAYOUT="/usr/share/plasma/shells/org.kde.plasma.desktop/contents/layout.js"

if [[ -f "${NEXUS_LAYOUT}" ]]; then
  echo "[0300-system-branding] Overriding all LookAndFeel desktop layouts with Nexus OS layout..."
  for lf_dir in /usr/share/plasma/look-and-feel/*; do
    if [[ -d "${lf_dir}" ]]; then
      mkdir -p "${lf_dir}/contents/layouts"
      cp -f "${NEXUS_LAYOUT}" "${lf_dir}/contents/layouts/org.kde.plasma.desktop-layout.js" || true
    fi
  done
fi

if [[ -f "${NEXUS_WALLPAPER}" ]]; then
  echo "[0300-system-branding] Setting NexusOS wallpaper system-wide..."
  mkdir -p /usr/share/desktop-base/active-theme/wallpaper/contents/images /usr/share/images/desktop-base
  for img_dir in /usr/share/desktop-base/*/wallpaper/contents/images /usr/share/desktop-base/active-theme/wallpaper/contents/images /usr/share/wallpapers/Ceratopsian*/contents/images; do
    if [[ -d "${img_dir}" ]]; then
      for f in "${img_dir}"/*; do
        if [[ -f "$f" ]]; then
          cp -f "${NEXUS_WALLPAPER}" "$f" || true
        fi
      done
    fi
  done
  cp -f "${NEXUS_WALLPAPER}" /usr/share/desktop-base/active-theme/wallpaper/contents/images/1920x1080.svg || true

  # Set Debian alternatives
  if command -v update-alternatives >/dev/null 2>&1; then
    update-alternatives --install /usr/share/images/desktop-base/desktop-background desktop-background "${NEXUS_WALLPAPER}" 100 || true
    update-alternatives --set desktop-background "${NEXUS_WALLPAPER}" || true
  fi

  # Set Breeze and Plasma defaults wallpaper
  for def_file in /usr/share/plasma/look-and-feel/*/contents/defaults; do
    if [[ -f "${def_file}" ]]; then
      sed -i 's|^defaultWallpaperTheme=.*|defaultWallpaperTheme=NexusOS|' "${def_file}" || true
      sed -i 's|^defaultImage=.*|defaultImage=file:///usr/share/wallpapers/NexusOS/contents/images/1920x1080.jpg|' "${def_file}" || true
    fi
  done
fi

# Pre-create users nexus and live with full skel pre-populated
for u in nexus live; do
  if ! id -u "${u}" >/dev/null 2>&1; then
    useradd -m -s /bin/bash -U -G sudo,audio,video,plugdev,netdev,input -c "The Nexus OS" "${u}" || true
  fi
  echo "${u}:${u}" | chpasswd || true
  
  if [[ -d /etc/skel ]] && [[ -d "/home/${u}" ]]; then
    cp -a /etc/skel/. "/home/${u}/"
    # Replace $HOME in user-places.xbel if present
    if [[ -f "/home/${u}/.local/share/user-places.xbel" ]]; then
      sed -i "s|\$HOME|/home/${u}|g" "/home/${u}/.local/share/user-places.xbel" || true
    fi
    chown -R "${u}:${u}" "/home/${u}" || true
  fi

  if [[ -d /etc/sudoers.d ]]; then
    echo "${u} ALL=(ALL) NOPASSWD: ALL" > "/etc/sudoers.d/${u}-nopasswd"
    chmod 0440 "/etc/sudoers.d/${u}-nopasswd"
  fi
done

echo "root:nexus" | chpasswd || true

# Allow blank password in PAM
if [[ -f /etc/pam.d/common-auth ]]; then
  sed -i 's/pam_unix.so.*/pam_unix.so nullok/' /etc/pam.d/common-auth
fi

echo "[0300-system-branding] System branding, wallpaper overrides, and user accounts configured."
